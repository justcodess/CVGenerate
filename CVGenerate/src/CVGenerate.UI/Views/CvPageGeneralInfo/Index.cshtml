@{
    ViewData["Title"] = "Genel Bilgiler";
    Layout = "/Views/Shared/_InfoLayout.cshtml";
}

<main class="content-scrollable info-page">
    <div class="accordion" id="accordionPanelsStayOpenExample" aria-live="polite">

        <!-- Açıklama -->
        <div class="accordion-item" data-section-id="description" draggable="true">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseDescription" aria-expanded="true" aria-controls="collapseDescription">
                    Açıklama
                </button>
            </h2>
            <div id="collapseDescription" class="accordion-collapse collapse show">
                <div class="accordion-body">
                    <textarea class="form-control" placeholder="Kişisel Açıklama Giriniz.." oninput="autoGrow(this)"></textarea>
                    <div class="buttons">
                        <button type="button" onclick="saveOrder()">Kaydet</button>
                    </div>
                </div>

            </div>

        </div>

        <!-- === İŞ DENEYİMİ === -->
        <div class="accordion-item" data-section-id="work" draggable="true">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseWork" aria-expanded="false" aria-controls="collapseWork">
                    İş Deneyimi
                </button>
            </h2>
            <div id="collapseWork" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <div id="work-section">
                        <div class="template-container">
                            <form>
                                <label>İş Unvanı</label>
                                <input type="text" placeholder="örn. Satış Yöneticisi" />
                                <label>Şehir/İlçe</label>
                                <input type="text" placeholder="örn. İstanbul" />
                                <label>İşveren</label>
                                <input type="text" placeholder="örn. PwC" />
                                <label>Açıklama</label>
                                <textarea rows="2" placeholder="Kısaca açıklayın..."></textarea>
                                <div class="buttons">
                                    <button type="button" class="clear-section">Temizle</button>
                                    <button type="button" class="delete-section">Sil</button>
                                    <button type="button" onclick="saveOrder()">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="add-another" onclick="window.duplicateSection('work-section')">Bir başka iş deneyimi ekle</div>
                </div>
            </div>
        </div>

        <!-- === EĞİTİM === -->
        <div class="accordion-item" data-section-id="education" draggable="true">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseEducation" aria-expanded="false" aria-controls="collapseEducation">
                    Eğitim ve Nitelikler
                </button>
            </h2>
            <div id="collapseEducation" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <div id="education-section">
                        <div class="template-container">
                            <form>
                                <label>Derece</label>
                                <input type="text" placeholder="örn. Lisans" />
                                <label>Şehir/İlçe</label>
                                <input type="text" placeholder="örn. Ankara" />
                                <label>Okul</label>
                                <input type="text" placeholder="örn. ODTÜ" />
                                <label>Tanım</label>
                                <textarea rows="2" placeholder="Kısaca açıklayın..."></textarea>
                                <div class="buttons">
                                    <button type="button" class="clear-section">Temizle</button>
                                    <button type="button" class="delete-section">Sil</button>
                                    <button type="button" onclick="saveOrder()">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="add-another" onclick="window.duplicateSection('education-section')">Bir başka eğitim ekle</div>
                </div>
            </div>
        </div>

        <!-- === HOBİ === -->
        <div class="accordion-item" data-section-id="hobby" draggable="true">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseHobby" aria-expanded="false" aria-controls="collapseHobby">
                    Hobi
                </button>
            </h2>
            <div id="collapseHobby" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <div id="hobby-section">
                        <div class="template-container">
                            <form>
                                <label>Hobi</label>
                                <input type="text" placeholder="örn. Fotoğrafçılık" />
                                <div class="buttons">
                                    <button type="button" class="clear-section">Temizle</button>
                                    <button type="button" class="delete-section">Sil</button>
                                    <button type="button" onclick="saveOrder()">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="add-another" onclick="window.duplicateSection('hobby-section')">Bir başka hobi ekle</div>
                </div>
            </div>
        </div>

        <!-- === REFERANSLAR === -->
        <div class="accordion-item" data-section-id="reference" draggable="true">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseReference" aria-expanded="false" aria-controls="collapseReference">
                    Referanslar
                </button>
            </h2>
            <div id="collapseReference" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <div id="reference-section">
                        <div class="template-container">
                            <form>
                                <label>Şirket Adı</label>
                                <input type="text" />
                                <label>İletişim Kişisi</label>
                                <input type="text" />
                                <label>Telefon</label>
                                <input type="text" />
                                <label>E-Posta</label>
                                <input type="email" />
                                <div class="buttons">
                                    <button type="button" class="clear-section">Temizle</button>
                                    <button type="button" class="delete-section">Sil</button>
                                    <button type="button" onclick="saveOrder()">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="add-another" onclick="window.duplicateSection('reference-section')">Bir başka referans ekle</div>
                </div>
            </div>
        </div>

        <!-- === BECERİLER === -->
        <div class="accordion-item" data-section-id="skill" draggable="true">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseSkill" aria-expanded="false" aria-controls="collapseSkill">
                    Beceriler
                </button>
            </h2>
            <div id="collapseSkill" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <div id="skill-section">
                        <div class="template-container">
                            <form>
                                <label>Beceri</label>
                                <input type="text" />
                                <label>Seviye</label>
                                <select>
                                    <option>Başlangıç</option>
                                    <option>Orta</option>
                                    <option>İyi</option>
                                    <option>Uzman</option>
                                </select>
                                <div class="buttons">
                                    <button type="button" class="clear-section">Temizle</button>
                                    <button type="button" class="delete-section">Sil</button>
                                    <button type="button" onclick="saveOrder()">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="add-another" onclick="window.duplicateSection('skill-section')">Bir başka beceri ekle</div>
                </div>
            </div>
        </div>

        <!-- === DİLLER === -->
        <div class="accordion-item" data-section-id="language" draggable="true">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseLanguage" aria-expanded="false" aria-controls="collapseLanguage">
                    Diller
                </button>
            </h2>
            <div id="collapseLanguage" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <div id="language-section">
                        <div class="template-container">
                            <form>
                                <label>Dil</label>
                                <input type="text" />
                                <label>Seviye</label>
                                <select>
                                    <option>A1</option>
                                    <option>A2</option>
                                    <option>B1</option>
                                    <option>B2</option>
                                    <option>C1</option>
                                    <option>C2 (Native)</option>
                                </select>
                                <div class="buttons">
                                    <button type="button" class="clear-section">Temizle</button>
                                    <button type="button" class="delete-section">Sil</button>
                                    <button type="button" onclick="saveOrder()">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="add-another" onclick="window.duplicateSection('language-section')">Bir başka dil ekle</div>
                </div>
            </div>
        </div>

        <!-- === KURSLAR === -->
        <div class="accordion-item" data-section-id="course" draggable="true">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseCourse" aria-expanded="false" aria-controls="collapseCourse">
                    Kurslar
                </button>
            </h2>
            <div id="collapseCourse" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <div id="course-section">
                        <div class="template-container">
                            <form>
                                <label>Kurs</label>
                                <input type="text" placeholder="örn. Java 101" />
                                <label>Kurum</label>
                                <input type="text" placeholder="örn. BTK Akademi" />
                                <label>Açıklama</label>
                                <textarea rows="2"></textarea>
                                <div class="buttons">
                                    <button type="button" class="clear-section">Temizle</button>
                                    <button type="button" class="delete-section">Sil</button>
                                    <button type="button" onclick="saveOrder()">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="add-another" onclick="window.duplicateSection('course-section')">Bir başka kurs ekle</div>
                </div>
            </div>
        </div>

    </div>
</main>

@section Scripts {

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.14.0/Sortable.min.js"></script>
    <script type="module" src="~/js/info.js"></script>
}


